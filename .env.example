# Copy this file to `.env` and fill in your own keys.
# Files named `.env` are git-ignored so secrets are never committed.

# Your AgentRouter (or other OpenAI-compatible) API key.
# Falls back to the in-app Settings panel if left empty.
VITE_API_KEY=

# Optional: override the API base URL and model.
VITE_API_BASE_URL=https://agentrouter.org/v1
VITE_API_MODEL=claude-opus-4-8

# Optional: AI proxy URL. Leave empty for local dev (uses the `npm run proxy`
# Node server on localhost:3001). On Vercel, set this to the path of the
# serverless proxy function, e.g. "/api" (so requests hit /api/chat/completions).
VITE_PROXY_URL=

# Optional: YouTube Data API v3 key used to search the YouTube library directly
# for a real, embeddable backing-track video (replaces the AI-guessed video ID).
# Get one at https://console.cloud.google.com/ (enable "YouTube Data API v3").
# If left empty, the app falls back to the AI-provided ID and the manual link.
VITE_YOUTUBE_API_KEY=
